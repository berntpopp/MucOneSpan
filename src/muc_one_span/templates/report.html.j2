<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MucOneSpan Report &ndash; {{ sample_name }}</title>
<style>
{% include "report.css" %}
</style>
</head>
<body>

<!-- ════════════════════════════════════════════════════════
     1. HEADER
     ════════════════════════════════════════════════════════ -->
<header class="report-header" aria-label="Report header">
  <h1>MucOneSpan Report</h1>
  <p class="meta">
    <span>Sample: <strong>{{ sample_name }}</strong></span>
    <span>Pipeline v{{ pipeline_version }}</span>
    <span>{{ generated_at }}</span>
  </p>
</header>

<!-- ════════════════════════════════════════════════════════
     1.5 CLINICAL DECISION BANNER (3-State)
     ════════════════════════════════════════════════════════ -->
{% if clinical_decision %}
<section class="decision-banner {{ clinical_decision.banner_class }}" aria-labelledby="decision-heading" role="region">
  <div class="decision-header">
    <span class="badge {{ clinical_decision.badge_class }}" aria-label="Status: {{ clinical_decision.badge_label }}">{{ clinical_decision.badge_label }}</span>
    <h2 id="decision-heading" class="decision-title">{{ clinical_decision.title }}</h2>
  </div>
  <p class="execution-status"><strong>Execution:</strong> {{ clinical_decision.execution.label }}</p>
  {% if clinical_decision.execution.warning %}
  <p class="execution-warning" role="status">{{ clinical_decision.execution.warning }}</p>
  {% endif %}
  <p class="decision-summary">{{ clinical_decision.summary }}</p>
  {% if clinical_decision.details %}
  <ul class="decision-details">
    {% for item in clinical_decision.details %}
    <li>{{ item }}</li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if clinical_decision.recommendations %}
  <div class="decision-recs">
    <strong>Clinical Guidance:</strong> {{ clinical_decision.recommendations }}
  </div>
  {% endif %}
</section>
{% endif %}

{% if multiplicity_caveat %}
<div class="alert alert-warning multiplicity-caveat" role="note" aria-label="Allele multiplicity caveat">
  <span class="alert-icon" aria-hidden="true">&#x26A0;</span>
  <div class="alert-content">
    <strong>Allele Multiplicity Note:</strong> {{ multiplicity_caveat }}
  </div>
</div>
{% endif %}

<!-- ════════════════════════════════════════════════════════
     2. ALLELE SUMMARY
     ════════════════════════════════════════════════════════ -->
<section aria-label="Allele summary">
  <h2>Allele Summary <span class="help-icon tip tip-wide" data-tip="Candidate alleles from reference-ladder fit. A second candidate does not by itself establish two reconstructed sequences.">?</span></h2>
  {% set alleles = summary.get("alleles", {}) %}
  {% set a1 = alleles.get("allele_1", {}) %}
  {% set a2 = alleles.get("allele_2", {}) %}
  {% set total_reads = (a1.get("reads", 0) + a2.get("reads", 0)) or 1 %}

  {% if alleles.get("sequence_identity_status") %}
  <p>Sequence identity: {{ alleles.get("sequence_identity_status") }}; Phase: {{ alleles.get("phase_status", "unverified") }}</p>
  {% elif alleles.get("homozygous") %}
  <p><span class="badge badge-info">Legacy homozygous designation (unverified)</span></p>
  {% endif %}

  <div class="card-grid" style="margin-top:0.75rem;">
    {# ── Allele 1 card ── #}
    <div class="card">
      <h3>Allele 1</h3>
      <div class="allele-stat">
        <div class="label">Repeat count <span class="help-icon tip" data-tip="Total repeat units including 5 pre-repeats and 4 after-repeats">?</span></div>
        <div class="value">{{ a1.get("length", "N/A") }}</div>
      </div>
      <div class="allele-stat">
        <div class="label">Canonical repeats <span class="help-icon tip" data-tip="Number of variable 60bp repeat units (excludes fixed pre/after-repeats)">?</span></div>
        <div class="value">{{ a1.get("canonical_repeats", "N/A") }}</div>
      </div>
      <div class="allele-stat">
        <div class="label">Alignment records <span class="help-icon tip" data-tip="Alignment records assigned to the candidate contig cluster; secondary alignments are reference-fit evidence, not independent molecules">?</span></div>
        <div class="value">{{ a1.get("reads", 0) }}</div>
      </div>
      <div class="allele-stat">
        <div class="label">Contig <span class="help-icon tip" data-tip="Best-matching reference ladder contig by alignment score">?</span></div>
        <div class="value">{{ a1.get("contig_name", "N/A") }}</div>
      </div>
      <div class="allele-stat">
        <div class="label">Read distribution <span class="help-icon tip tip-wide" data-tip="Proportion of reads for this allele. Shorter alleles amplify more in PCR, so unequal bars are normal.">?</span></div>
        <div class="read-bar-track tip" data-tip="{{ a1.get('reads', 0) }} / {{ total_reads }} reads ({{ (a1.get('reads', 0) / total_reads * 100)|round(1) }}%)"
             role="progressbar"
             aria-valuenow="{{ a1.get('reads', 0) }}" aria-valuemin="0"
             aria-valuemax="{{ total_reads }}"
             aria-label="Allele 1 read proportion">
          <div class="read-bar-fill"
               style="width:{{ (a1.get('reads', 0) / total_reads * 100)|round(1) }}%"></div>
        </div>
      </div>
    </div>

    {# ── Allele 2 card ── #}
    <div class="card">
      <h3>Allele 2</h3>
      <div class="allele-stat">
        <div class="label">Repeat count <span class="help-icon tip" data-tip="Total repeat units including 5 pre-repeats and 4 after-repeats">?</span></div>
        <div class="value">{{ a2.get("length", "N/A") }}</div>
      </div>
      <div class="allele-stat">
        <div class="label">Canonical repeats <span class="help-icon tip" data-tip="Number of variable 60bp repeat units (excludes fixed pre/after-repeats)">?</span></div>
        <div class="value">{{ a2.get("canonical_repeats", "N/A") }}</div>
      </div>
      <div class="allele-stat">
        <div class="label">Alignment records <span class="help-icon tip" data-tip="Alignment records assigned to the candidate contig cluster; secondary alignments are reference-fit evidence, not independent molecules">?</span></div>
        <div class="value">{{ a2.get("reads", 0) }}</div>
      </div>
      <div class="allele-stat">
        <div class="label">Contig <span class="help-icon tip" data-tip="Best-matching reference ladder contig by alignment score">?</span></div>
        <div class="value">{{ a2.get("contig_name", "N/A") }}</div>
      </div>
      <div class="allele-stat">
        <div class="label">Read distribution <span class="help-icon tip tip-wide" data-tip="Proportion of reads for this allele. Shorter alleles amplify more in PCR, so unequal bars are normal.">?</span></div>
        <div class="read-bar-track tip" data-tip="{{ a2.get('reads', 0) }} / {{ total_reads }} reads ({{ (a2.get('reads', 0) / total_reads * 100)|round(1) }}%)"
             role="progressbar"
             aria-valuenow="{{ a2.get('reads', 0) }}" aria-valuemin="0"
             aria-valuemax="{{ total_reads }}"
             aria-label="Allele 2 read proportion">
          <div class="read-bar-fill"
               style="width:{{ (a2.get('reads', 0) / total_reads * 100)|round(1) }}%"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════
     3. REPEAT STRUCTURE VISUALIZATION
     ════════════════════════════════════════════════════════ -->
{% set classifications = summary.get("classifications", {}) %}
{% if classifications %}
<section aria-label="Repeat structure visualization">
  <h2>Repeat Structure <span class="help-icon tip tip-wide" data-tip="Each block is one 60bp repeat unit. Hover a block to see its type and position. Colors indicate the repeat category.">?</span></h2>

  {# Legend #}
  <div class="legend" aria-label="Repeat type legend">
    <div class="legend-item"><span class="legend-swatch ru-pre"></span> Pre-repeat</div>
    <div class="legend-item"><span class="legend-swatch ru-canonical"></span> Canonical</div>
    <div class="legend-item"><span class="legend-swatch ru-variant"></span> Variant</div>
    <div class="legend-item"><span class="legend-swatch ru-after"></span> After-repeat</div>
    <div class="legend-item"><span class="legend-swatch ru-mutation"></span> Mutation</div>
  </div>

  {% for allele_key in ["allele_1", "allele_2"] %}
  {% set cls = classifications.get(allele_key, {}) %}
  {% set structure = cls.get("structure", "") %}
  {% if structure %}
  <h3>{{ allele_key | replace("_", " ") | title }}</h3>
  <div class="repeat-map" aria-label="{{ allele_key }} repeat map">
    {% for unit_type in structure.split(" ") %}
      {# Categorise the repeat type #}
      {% if unit_type in ["1","2","3","4","5"] %}
        {% set cat = "pre" %}
      {% elif unit_type in ["6","6p","7","8","9"] %}
        {% set cat = "after" %}
      {% elif ":" in unit_type or unit_type.endswith("m") %}
        {% set cat = "mutation" %}
      {% elif unit_type.startswith("?") %}
        {% set cat = "variant" %}
      {% else %}
        {% set cat = "canonical" %}
      {% endif %}
      <span class="repeat-unit ru-{{ cat }}"
            data-tip="#{{ loop.index }} {{ unit_type }} ({{ cat }})"
            aria-label="Repeat {{ loop.index }}: {{ unit_type }} ({{ cat }})"></span>
    {% endfor %}
  </div>
  {% endif %}
  {% endfor %}
</section>
{% endif %}

<!-- ════════════════════════════════════════════════════════
     4. MUTATION REPORT TABLE
     ════════════════════════════════════════════════════════ -->
<section aria-label="Mutation report">
  <h2>Mutation Report <span class="help-icon tip tip-wide" data-tip="Frameshift mutations (insertions/deletions not divisible by 3) in repeat units. These cause ADTKD-MUC1 disease.">?</span></h2>
  {% set any_mutations = [] %}
  {% for akey in ["allele_1", "allele_2"] %}
    {% for m in classifications.get(akey, {}).get("mutations", []) %}
      {% if any_mutations.append({"allele": akey, "m": m}) %}{% endif %}
    {% endfor %}
  {% endfor %}

  {% if any_mutations | length > 0 %}
  <table>
    <thead>
      <tr>
        <th>Allele</th>
        <th class="tip" data-tip="Position of the mutated repeat unit in the allele">Repeat #</th>
        <th class="tip" data-tip="The canonical repeat type before mutation occurred">Parent type</th>
        <th class="tip" data-tip="Name of the detected mutation (e.g. 59dupC = cytosine duplication)">Mutation</th>
        <th class="tip" data-tip="Official HGVS cDNA nomenclature (NM_001204286.1)">HGVS cDNA</th>
        <th class="tip" data-tip="Repeat tract copy-number transition notation">Repeat form</th>
        <th class="tip" data-tip="5'-roll to 3'-most normalization ambiguity interval (1-based)">Ambiguity</th>
        <th class="tip" data-tip="Clinical confidence tier (Tier A = established pathogenic)">Tier</th>
        <th class="tip" data-tip="Frameshift: indel length not divisible by 3, disrupts reading frame">Frameshift</th>
        <th class="tip" data-tip="Exact sequence concordance with the VCF used to construct the consensus, or unavailable when projection cannot be verified">VCF support</th>
        <th class="tip" data-tip="Clair3 quality score: higher = more confident variant call">QUAL</th>
        <th class="tip" data-tip="Mutations near allele boundaries may be alignment artifacts (0.5x penalty)">Boundary</th>
      </tr>
    </thead>
    <tbody>
      {% for entry in any_mutations %}
      {% set m = entry.m %}
      <tr>
        <td>{{ entry.allele | replace("_", " ") | title }}</td>
        <td>{{ m.get("repeat_index", "N/A") }}</td>
        <td>{{ m.get("closest_type", "N/A") }}</td>
        <td>
          <strong>{{ m.get("canonical_name", m.get("mutation_name", "N/A")) }}</strong>
          {% if m.get("canonical_name") and m.get("mutation_name") and m.get("canonical_name") != m.get("mutation_name") %}
            <br><small style="color:var(--fg-muted);">({{ m.get("mutation_name") }})</small>
          {% endif %}
        </td>
        <td><code>{{ m.get("hgvs_cdna") or "—" }}</code></td>
        <td><code>{{ m.get("repeat_form") or "—" }}</code></td>
        <td>
          {% if m.get("ambiguity_interval") %}
            <code>({{ m["ambiguity_interval"][0] }}, {{ m["ambiguity_interval"][1] }})</code>
          {% else %}
            &mdash;
          {% endif %}
        </td>
        <td>
          {% if m.get("confidence_tier") == "Tier_A" or m.get("is_known_variant") %}
            <span class="badge badge-danger tip" data-tip="{{ m.get('literature_citation', 'Pathogenic') }}">Tier A</span>
          {% elif m.get("confidence_tier") == "Tier_B" or m.get("frameshift") %}
            <span class="badge badge-warning">Tier B</span>
          {% else %}
            <span class="badge badge-info">Tier C</span>
          {% endif %}
        </td>
        <td>
          {% if m.get("frameshift") %}
            <span class="badge badge-danger">Frameshift</span>
          {% else %}
            <span class="badge badge-success">In-frame</span>
          {% endif %}
        </td>
        <td>
          {% if m.get("vcf_support") %}
            <span class="badge badge-success">Supported</span>
          {% elif m.get("vcf_support_status") == "projection_unavailable" %}
            <span class="badge badge-info">Support unavailable</span>
          {% elif m.get("vcf_support_status") == "localization_ambiguous" %}
            <span class="badge badge-info">Support ambiguous</span>
          {% elif m.get("vcf_support_status") == "heterozygous_genotype_unresolved" %}
            <span class="badge badge-info">Genotype unresolved</span>
          {% else %}
            <span class="badge badge-warning">Unsupported</span>
          {% endif %}
        </td>
        <td>{{ m.get("vcf_qual", "N/A") }}</td>
        <td>
          {% if m.get("boundary") %}
            <span class="badge badge-warning">Boundary</span>
          {% else %}
            &mdash;
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p style="color:var(--fg-muted);">No mutations detected in either allele.</p>
  {% endif %}
</section>

<!-- ════════════════════════════════════════════════════════
     5. QUALITY METRICS
     ════════════════════════════════════════════════════════ -->
{% if detailed_repeats %}
<section aria-label="Quality metrics">
  <h2>Quality Metrics <span class="help-icon tip tip-wide" data-tip="Classification quality per allele. Green (>=80%) is good, yellow (>=50%) is moderate, red (<50%) needs review.">?</span></h2>
  <div class="card-grid">
    {% for allele_key in ["allele_1", "allele_2"] %}
    {% set dr = detailed_repeats.get(allele_key, {}) %}
    {% set conf = dr.get("confidence", dr.get("allele_confidence", 0)) %}
    {% set exact = dr.get("exact_match_pct") | exact_match_percentage %}
    {# Hybrid alleles carry consensus_concordance_fraction / classification_confidence_status
       (see hybrid/allele_fields.py::allele_info, commit 3080dc9): the ladder's classify.py
       "confidence" above is a dictionary-fit heuristic fed identically for both engines and
       carries no hybrid reconstruction evidence, so hybrid alleles show their own read-support
       evidence here instead of that value. Detected via the fields the hybrid engine adds, not
       a hardcoded engine name. #}
    {% set hybrid_status = alleles.get(allele_key, {}).get("classification_confidence_status") %}
    <div class="card">
      <h3>{{ allele_key | replace("_", " ") | title }}</h3>

      <div style="margin-bottom:0.75rem;">
        {% if hybrid_status %}
        {% set concordance = alleles.get(allele_key, {}).get("consensus_concordance_fraction") %}
        <div class="metric-row">
          <span class="metric-label tip" data-tip="Mean per-base agreement between the final polished consensus and every read that built/polished it (hybrid/polish.py::consensus_concordance)">Read support (consensus concordance)</span>
          <span class="metric-value">{{ "%.1f"|format(concordance * 100) if concordance is not none else "N/A" }}%</span>
        </div>
        {% if concordance is not none %}
        {% set concordance_pct = concordance * 100 %}
        <div class="progress-track" role="progressbar"
             aria-valuenow="{{ concordance_pct|round(1) }}"
             aria-valuemin="0" aria-valuemax="100"
             aria-label="{{ allele_key }} consensus concordance">
          <div class="progress-fill {{ 'good' if concordance_pct >= 80 else ('ok' if concordance_pct >= 50 else 'poor') }}"
               style="width:{{ concordance_pct|round(1) }}%"></div>
        </div>
        {% endif %}
        <div class="metric-row" style="margin-top:0.5rem;">
          <span class="metric-label tip" data-tip="The ladder's dictionary-fit classification confidence does not apply to hybrid reconstruction quality; see read support above">Classification confidence</span>
          <span class="metric-value">{{ hybrid_status }}</span>
        </div>
        {% else %}
        <div class="metric-row">
          <span class="metric-label tip" data-tip="Average classification confidence across all repeat units">Allele confidence</span>
          <span class="metric-value">{{ "%.1f"|format(conf * 100) if conf <= 1 else "%.1f"|format(conf) }}%</span>
        </div>
        <div class="progress-track" role="progressbar"
             aria-valuenow="{{ (conf * 100)|round(1) if conf <= 1 else conf|round(1) }}"
             aria-valuemin="0" aria-valuemax="100"
             aria-label="{{ allele_key }} confidence">
          {% set conf_pct = (conf * 100) if conf <= 1 else conf %}
          <div class="progress-fill {{ 'good' if conf_pct >= 80 else ('ok' if conf_pct >= 50 else 'poor') }}"
               style="width:{{ conf_pct|round(1) }}%"></div>
        </div>
        {% endif %}
      </div>

      <div>
        <div class="metric-row">
          <span class="metric-label tip" data-tip="Percentage of repeat units that exactly match a known reference sequence">Exact match</span>
          <span class="metric-value">{{ "%.1f%%"|format(exact) if exact is not none else "—" }}</span>
        </div>
        {% if exact is not none %}
        <div class="progress-track" role="progressbar"
             aria-valuenow="{{ '%.1f'|format(exact) }}"
             aria-valuemin="0" aria-valuemax="100"
             aria-label="{{ allele_key }} exact match percentage">
          {% set exact_pct = exact %}
          <div class="progress-fill {{ 'good' if exact_pct >= 80 else ('ok' if exact_pct >= 50 else 'poor') }}"
               style="width:{{ '%.1f'|format(exact_pct) }}%"></div>
        </div>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

<!-- ════════════════════════════════════════════════════════
     6. DETAILED REPEAT TABLE (collapsible)
     ════════════════════════════════════════════════════════ -->
{% if detailed_repeats %}
<section aria-label="Detailed repeat data">
  <h2>Detailed Repeats</h2>
  {% for allele_key in ["allele_1", "allele_2"] %}
  {% set dr = detailed_repeats.get(allele_key, {}) %}
  {% set repeats = dr.get("repeats", []) %}
  {% if repeats %}
  <details>
    <summary>{{ allele_key | replace("_", " ") | title }} &mdash; {{ repeats | length }} units</summary>
    <div style="overflow-x:auto;margin-top:0.5rem;">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Type</th>
          <th>Classification</th>
          <th>Confidence</th>
          <th>Edit dist.</th>
          <th>Identity %</th>
        </tr>
      </thead>
      <tbody>
        {% for r in repeats %}
        <tr>
          <td>{{ r.get("index", loop.index) }}</td>
          <td>{{ r.get("type", "N/A") }}</td>
          <td>{{ r.get("classification", r.get("match", "N/A")) }}</td>
          <td>{{ "%.2f"|format(r.get("confidence", 0)) }}</td>
          <td>{{ r.get("edit_distance", "N/A") }}</td>
          <td>{{ "%.1f"|format(r.get("identity_pct", 0)) }}%</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  </details>
  {% endif %}
  {% endfor %}
</section>
{% endif %}

<!-- ════════════════════════════════════════════════════════
     7. INTERACTIVE ALIGNMENT BROWSER
     ════════════════════════════════════════════════════════ -->
{% if igv and igv.has_igv %}
<section aria-label="Interactive alignment browser">
  <h2>Interactive Alignment Browser <span class="help-icon tip tip-wide" data-tip="Zero-network offline IGV alignment browser showing reads and variants across the MUC1 VNTR locus.">?</span></h2>
  {% if igv.mode == "embedded" %}
  <div class="igv-container-wrapper" style="margin-top:1rem;background:var(--bg-surface);border:1px solid var(--border);border-radius:var(--radius);padding:1rem;">
    {{ igv.igv_content | safe }}
  </div>
  {% elif igv.mode == "sidecar" and igv.sidecar_path %}
  <div class="card" style="margin-top:1rem;padding:1.25rem;">
    <p>Alignment browser generated in a separate offline HTML sidecar:</p>
    <p><a href="{{ igv.sidecar_path.name }}" class="badge badge-info" style="font-size:0.95rem;padding:0.4rem 0.8rem;text-decoration:none;" target="_blank" rel="noopener">Open Interactive Alignment Browser ({{ igv.sidecar_path.name }}) &rarr;</a></p>
  </div>
  {% endif %}
</section>
{% endif %}

<!-- ════════════════════════════════════════════════════════
     8. REPRODUCIBILITY FOOTER
     ════════════════════════════════════════════════════════ -->
<footer class="report-footer" aria-label="Reproducibility information">
  <dl>
    <dt>Pipeline</dt>
    <dd>MucOneSpan v{{ pipeline_version }}</dd>
    <dt>Generated</dt>
    <dd>{{ generated_at }}</dd>
    {% if igv_provenance %}
    <dt>Alignment Browser</dt>
    <dd>{{ igv_provenance }}</dd>
    {% endif %}
    {% for name, version in tool_versions.items() %}
    <dt>{{ name }}</dt>
    <dd>{{ version }}</dd>
    {% endfor %}
  </dl>
</footer>

{% if igv and igv.mode == "embedded" and igv.has_igv %}
<script>
const tableJson = {{ igv.table_json | safe }};
const sessionDictionary = {{ igv.session_dictionary | safe }};
const IGV_GZ_B64 = "{{ igv_payload }}";
let igvBrowser = null;

function describeRow(headers, rowData) {
    const parts = [];
    for (let i = 1; i < headers.length; i++) {
        parts.push(headers[i] + " " + rowData[i]);
    }
    return parts.join(", ");
}

function selectRow(row, button) {
    document.querySelectorAll("#variant_table tbody tr").forEach(function (candidate) {
        const selected = candidate === row;
        candidate.setAttribute("aria-selected", String(selected));
        const candidateBtn = candidate.querySelector("button");
        if (candidateBtn) candidateBtn.textContent = selected ? "Showing" : "Show";
    });
    button.focus();
}

function showSession(row, button) {
    const session = sessionDictionary[row.dataset.id];
    if (!igvBrowser || !session) return;
    igvBrowser.loadSession({url: session}).then(function () {
        selectRow(row, button);
    });
}

function initTable() {
    const host = document.getElementById("tableSelectorDiv");
    if (!host || !tableJson || !tableJson.headers || !tableJson.rows) return;
    const table = document.createElement("table");
    table.id = "variant_table";
    const head = table.createTHead();
    const headerRow = head.insertRow();
    const viewHeader = document.createElement("th");
    viewHeader.scope = "col";
    viewHeader.textContent = "View";
    headerRow.appendChild(viewHeader);

    tableJson.headers.slice(1).forEach(function (header) {
        const cell = document.createElement("th");
        cell.scope = "col";
        cell.textContent = header;
        headerRow.appendChild(cell);
    });

    const body = table.createTBody();
    tableJson.rows.forEach(function (rowData, rowIndex) {
        const row = body.insertRow();
        row.dataset.id = rowData[0];
        row.setAttribute("aria-selected", String(rowIndex === 0));
        const action = row.insertCell();
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = rowIndex === 0 ? "Showing" : "Show";
        button.setAttribute("aria-label", button.textContent + " " + describeRow(tableJson.headers, rowData));
        button.addEventListener("click", function () {
            showSession(row, button);
        });
        action.appendChild(button);

        rowData.slice(1).forEach(function (value) {
            const cell = row.insertCell();
            cell.textContent = value;
        });
    });
    host.appendChild(table);
}

function setIgvState(message) {
    const state = document.getElementById("igvState");
    if (state) state.textContent = message;
}

async function loadIgv() {
    if (typeof IGV_GZ_B64 === "undefined" || typeof DecompressionStream === "undefined") {
        return null;
    }
    const bytes = Uint8Array.from(atob(IGV_GZ_B64), function (c) { return c.charCodeAt(0); });
    const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream("gzip"));
    const source = await new Response(stream).text();
    (0, eval)(source);
    return window.igv;
}

document.addEventListener("DOMContentLoaded", function () {
    initTable();
    if (typeof sessionDictionary !== "undefined" && Object.keys(sessionDictionary).length > 0) {
        loadIgv().then(function (igv) {
            if (!igv) {
                setIgvState("The alignment browser library is unavailable. The variant table remains complete.");
                return;
            }
            const igvDiv = document.getElementById("igvDiv");
            if (!igvDiv) return;
            const firstKey = Object.keys(sessionDictionary)[0];
            const options = {
                sessionURL: sessionDictionary[firstKey],
                showChromosomeWidget: false,
                showCenterGuide: true,
                search: false,
                loadDefaultGenomes: false,
            };
            igv.createBrowser(igvDiv, options).then(function (browser) {
                igvBrowser = browser;
                const state = document.getElementById("igvState");
                if (state) state.remove();
            }).catch(function (error) {
                setIgvState("The alignment browser could not be started: " + String(error));
            });
        }).catch(function (error) {
            setIgvState("The alignment browser could not be loaded: " + String(error));
        });
    }
});
</script>
{% endif %}

